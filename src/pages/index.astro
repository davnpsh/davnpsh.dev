---
import { Font } from "astro:assets";

import Grub from "../subpages/boot/grub.astro";
import Log from "../subpages/boot/log.astro";
import LoadingDialog from "../subpages/boot/loading-dialog.astro";
import Home from "../subpages/home/normal.astro";

import "../layouts/crt.css";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/ico" href="/favicon.ico" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-unifont" />
        <title>daru's system</title>
    </head>
    <body>
        <div class="crt"></div>
        <div class="content" id="grub">
            <Grub />
        </div>
        <div class="content" id="log">
            <Log />
        </div>
        <div class="content" id="loading-dialog">
            <LoadingDialog />
        </div>
        <div class="content" id="home">
            <Home />
        </div>
    </body>
</html>

<style>
    body {
        position: relative;
    }
    
    .content {
        display: none;
    }
</style>

<script>
    function set_boot_stage(id: string) {
        localStorage.setItem("boot-stage", id);

        document.dispatchEvent(new CustomEvent("stage-change", { detail: id }));
    }

    document.addEventListener("stage-change", (e: any) => {
        document.querySelectorAll(".content").forEach((element) => {
            (element as HTMLElement).style.display = "none";
        });

        const element = document.getElementById(e.detail);

        if (element) element.style.display = "initial";
    });

    document.addEventListener("DOMContentLoaded", () => {
        let bootloader = localStorage.getItem("disable-bootloader");

        if (bootloader === "true") {
            set_boot_stage("home");
        } else {
            set_boot_stage("grub");
        }
    });
</script>
