---
import Grub from "../subpages/boot/grub.astro";
---

<div class="content" id="grub">
    <Grub />
</div>

<style>
    .content {
        display: none;
    }
</style>

<script>
    function load_content(id: string) {
        const element = document.getElementById(id);
        element!.style.display = "initial";
    }

    document.addEventListener("DOMContentLoaded", () => {
        // Load GRUB first always
        localStorage.setItem("boot-stage", "grub");

        setInterval(() => {
            document.querySelectorAll(".content").forEach((element) => {
                // @ts-ignore
                element!.style.display = "none";
            });

            const id = localStorage.getItem("boot-stage");
            load_content(id!);
        }, 200);
    });
</script>
