---
import Grub from "../subpages/boot/grub.astro";
---

<div class="content" id="grub">
    <Grub />
</div>

<style>
    .content {
        display: none;
    }
</style>

<script>
    function set_boot_stage(id: string) 
    {
        localStorage.setItem("boot-stage", id);
        
        document.dispatchEvent(
            new CustomEvent("stage-change", { detail: id }),
        );
    }
    
    document.addEventListener("stage-change", (e: any) => {
        document.querySelectorAll(".content").forEach((element) => {
            (element as HTMLElement).style.display = "none";
        });

        const element = document.getElementById(e.detail);

        if (element) element.style.display = "initial";
    });

    document.addEventListener("DOMContentLoaded", () => {
        // Load GRUB first always
        set_boot_stage("grub");
    });
</script>
