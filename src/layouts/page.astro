---
import { Font, Image } from "astro:assets";

import WallpaperTile04 from "../assets/wallpapers/Boutros-Boutros-Ghali-1.jpg";

import ynBadge from "../assets/badges/beyes.gif";
import blinkBadge from "../assets/badges/blink-0.gif";
import fedoraBadge from "../assets/badges/fedora.gif";
import htmlBadge from "../assets/badges/gethtmlnow.gif";
import githubBadge from "../assets/badges/github.gif";
import linuxBadge from "../assets/badges/gnu-linux.gif";
import xpBadge from "../assets/badges/xp.gif";

import "./crt.css";

const { title = "default" } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/ico" href="/favicon.ico" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <Font cssVariable="--font-unifont" />
        <!-- @ts-ignore: stupid error -->
        <Font cssVariable="--font-special-elite" />
        <title>daru's system</title>
    </head>
    <body style={`--bg-image: url(${WallpaperTile04.src})`}>
        <div class="crt"></div>
        <div class="container">
            <header>
                <div class="logo">
                    <span>d</span><span>a</span><span>r</span><span>u</span
                    ><span>'</span><span>s</span>&nbsp;
                    <span>s</span><span>y</span><span>s</span><span>t</span
                    ><span>e</span><span>m</span>
                </div>
                <nav>
                    <ul>
                        <li>
                            <a href="/"
                                ><span>H</span><span>o</span><span>m</span><span
                                    >e</span
                                ></a
                            >
                        </li>
                        <li>
                            <a href="/about"
                                ><span>A</span><span>b</span><span>o</span><span
                                    >u</span
                                ><span>t</span></a
                            >
                        </li>
                        <li>
                            <a href="/projects"
                                ><span>P</span><span>r</span><span>o</span><span
                                    >j</span
                                ><span>e</span><span>c</span><span>t</span><span
                                    >s</span
                                ></a
                            >
                        </li>
                        <li>
                            <a href="/contact"
                                ><span>C</span><span>o</span><span>n</span><span
                                    >t</span
                                ><span>a</span><span>c</span><span>t</span></a
                            >
                        </li>
                    </ul>
                </nav>
            </header>

            <main>
                <h1>{title}</h1>
                <slot />
            </main>

            <footer>
                <Image src={ynBadge} alt="" />
                <Image src={blinkBadge} alt="" />
                <Image src={fedoraBadge} alt="" />
                <Image src={githubBadge} alt="" />
                <Image src={linuxBadge} alt="" />
                <Image src={xpBadge} alt="" />
                <Image src={htmlBadge} alt="" />
            </footer>
        </div>
    </body>
</html>

<style>
    * {
        padding: 0;
        margin: 0;
        box-sizing: border-box;
    }

    body {
        background-image:
            linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)),
            var(--bg-image);
        background-size: auto;
        font-family: var(--font-unifont);
        position: relative;
    }

    .container {
        margin: auto;
        padding-top: 20px;
        width: 40%;
    }

    header {
        width: 100%;
        padding: 20px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    @keyframes shake {
        0%,
        100% {
            transform: translate(0, 0) rotate(0deg);
        }
        25% {
            transform: translate(-1px, 1px) rotate(-1deg);
        }
        50% {
            transform: translate(1px, -1px) rotate(1deg);
        }
        75% {
            transform: translate(-1px, -1px) rotate(0.5deg);
        }
    }

    header .logo {
        font-family: var(--font-special-elite);
        font-size: 30px;
        font-weight: bold;
        color: white;
        user-select: none;
    }

    header .logo span {
        display: inline-block;
        animation: shake 0.2s infinite;
    }

    header .logo span:nth-child(2n) {
        animation-delay: 0.1s;
    }

    header .logo span:nth-child(3n) {
        animation-delay: 0.15s;
    }

    header .logo span:nth-child(4n) {
        animation-delay: 0.2s;
    }

    header nav ul {
        list-style: none;
        display: flex;
        gap: 30px;
    }

    header nav ul li a {
        text-decoration: none;
        font-weight: bold;
        color: white;
        font-size: 18px;
    }

    header nav ul li a:hover span {
        display: inline-block;
        animation: shake 0.2s infinite;
    }

    header nav ul li a span:nth-child(2n) {
        animation-delay: 0.1s;
    }

    header nav ul li a span:nth-child(3n) {
        animation-delay: 0.15s;
    }

    header nav ul li a span:nth-child(4n) {
        animation-delay: 0.2s;
    }

    main {
        margin-top: 60px;
        margin-bottom: 40px;
    }

    main h1 {
        text-align: center;
        color: white;
        font-family: var(--font-special-elite);
    }

    footer {
        margin: 20px 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 5px;
    }

    /* RESPONSIVE-NESS */
    @media (max-width: 1920px) {
        .container {
            width: 60%;
        }
    }

    @media (max-width: 1280px) {
        .container {
            width: 80%;
        }
    }

    @media (max-width: 1024px) {
        .container {
            width: 95%;
        }

        header {
            flex-direction: column;
            gap: 20px;
        }
    }
</style>
