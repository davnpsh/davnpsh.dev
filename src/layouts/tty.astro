---
/*
Basic styles for a TTY look and feel.
*/
---

<slot />

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;

        font-family: var(--font-unifont), monospace;
        font-size: 18px;
        user-select: none;
        -webkit-font-smoothing: none;
        font-smooth: never;
        image-rendering: pixelated;
    }
</style>
